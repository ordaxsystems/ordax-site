{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "out/site",
  "installCommand": "npm ci --omit=dev --ignore-scripts --no-audit --no-fund && python3 scripts/stage_canonical_gateway.py --out .gateway-source",
  "buildCommand": "python3 scripts/build.py build --source-commit \"$VERCEL_GIT_COMMIT_SHA\" --dev-lock contracts/dev-artifact-lock.json --public-origin https://ordax.com.br --out out/site && python3 scripts/build.py verify --out out/site",
  "git": {
    "deploymentEnabled": {
      "**": false,
      "main": true
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; script-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self' https://challenges.cloudflare.com; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/auth/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/account/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/sync/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/config/public-site.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/releases/catalog.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/auth/:path*",
      "destination": "/api/account-proxy?ordax_path=/auth/:path*"
    },
    {
      "source": "/sync/:path*",
      "destination": "/api/account-proxy?ordax_path=/sync/:path*"
    },
    {
      "source": "/account/:path*",
      "destination": "/api/account-proxy?ordax_path=/account/:path*"
    }
  ]
}
